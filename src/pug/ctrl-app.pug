extends ./_template.pug

block append title
  | Ctrl app

block page
  include _selector.pug

  div.boxes.grid
    div.box
      h2 Advanced config made easy
      p An #[em optional] app for Input Labs devices, able to edit profiles, adjust settings, and inspect the firmware internals.
      p It is packed with advanced #[+a('ctrl-app-features') features] such as cross-device binds, #[em flick-stick], anti-deadzone, #[em daisy-wheel] keyboard, and much more.
      p Made with love, the user interface is crafted to be #[em.wrap direct and self-explanatory], without nested submenus.
      p The Ctrl app remains compatible with #[em Steam Input UI] if you want to use both, or either one on its own.

    div.box.image.black.centered
      img(src='/static/manual/ctrl_app_profiles.png')

    div.box.image.black.centered
      img(src='/static/manual/ctrl_app_profiles_custom.png')

    div.box.image.black.centered
      img(src='/static/manual/ctrl_app_profiles_bind.png')

    div.box.image.black.centered
      img(src='/static/manual/ctrl_app_logs.png')

    div.box
      h2 No bloatware, privacy-friendly
      p Without #[em login], without #[em tracking], without background services, and without mandatory install.
      p The Ctrl app changes the configuration directly in the controller's #[em internal memory], so it does not need to run anything in the background.
      p It is based on #[em WebUSB] and compatible with #[em Windows], #[em Linux], and the #[em Steam Deck]. It can be used in a browser, or installed locally for offline use.
      p The source code is available on #[+ax(org.repo+'ctrl') GitHub].
